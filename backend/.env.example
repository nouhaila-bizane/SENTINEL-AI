PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sentinel_ai
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d
COOKIE_SECRET=CHANGE_THIS_COOKIE_SECRET_MIN_32_CHARS
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
SUPER_ADMIN_NAME=Platform Owner
SUPER_ADMIN_EMAIL=owner@sentinel.ai
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ALLOW_REGISTRATION=true
MAINTENANCE_MODE=false
